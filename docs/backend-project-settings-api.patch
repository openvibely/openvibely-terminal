+func TestAPIProjectSettingsUpdateReclonesChangedRepositoryAndReturnsManagedPath(t *testing.T) {
+	t.Setenv("OPENVIBELY_ENABLE_LOCAL_REPO_PATH", "false")
+	h, e, _ := setupTestHandler(t)
+	ctx := context.Background()
+	project := &models.Project{
+		Name: "GitHub Project", RepoPath: "/managed/old", RepoURL: "https://github.com/acme/old",
+	}
+	if err := h.projectSvc.Create(ctx, project); err != nil {
+		t.Fatalf("create project: %v", err)
+	}
+	calls := 0
+	h.githubSvc = &fakeGitHubService{recloneFn: func(_ context.Context, projectID, currentPath, repoURL string) (string, string, error) {
+		calls++
+		if projectID != project.ID || currentPath != "/managed/old" || repoURL != "https://github.com/acme/new" {
+			t.Fatalf("reclone arguments = %q %q %q", projectID, currentPath, repoURL)
+		}
+		return "/managed/new-checkout", "https://github.com/acme/new", nil
+	}}
+	payload := map[string]any{
+		"name": project.Name, "description": "", "repository_source": "github",
+		"repository_path": project.RepoPath, "github_url": "https://github.com/acme/new",
+		"default_agent_id": "", "max_workers": nil,
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodPut, "/api/projects/"+project.ID+"/settings", strings.NewReader(string(body)))
+	request.Header.Set("Content-Type", "application/json")
+	e.ServeHTTP(recorder, request)
+	if recorder.Code != http.StatusNoContent || calls != 1 {
+		t.Fatalf("PUT settings = %d %s; reclone calls = %d", recorder.Code, recorder.Body.String(), calls)
+	}
+	persisted, err := h.projectSvc.GetByID(ctx, project.ID)
+	if err != nil {
+		t.Fatalf("load project after reclone: %v", err)
+	}
+	if persisted.RepoPath != "/managed/new-checkout" || persisted.RepoURL != "https://github.com/acme/new" {
+		t.Fatalf("persisted GitHub repository = path %q URL %q", persisted.RepoPath, persisted.RepoURL)
+	}
+
+	readRecorder := httptest.NewRecorder()
+	e.ServeHTTP(readRecorder, httptest.NewRequest(http.MethodGet, "/api/projects/"+project.ID+"/settings", nil))
+	var refreshed ProjectSettingsResponse
+	if err := json.Unmarshal(readRecorder.Body.Bytes(), &refreshed); err != nil {
+		t.Fatalf("decode refreshed settings: %v", err)
+	}
+	if readRecorder.Code != http.StatusOK || refreshed.RepositoryPath != "/managed/new-checkout" {
+		t.Fatalf("GET after reclone = %d %+v", readRecorder.Code, refreshed)
+	}
+}
