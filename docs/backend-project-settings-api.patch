diff --git a/internal/handler/api_project_handler.go b/internal/handler/api_project_handler.go
index f16fa0051..3de5596fd 100644
--- a/internal/handler/api_project_handler.go
+++ b/internal/handler/api_project_handler.go
@@ -3,0 +4,3 @@ import (
+	"encoding/json"
+	"fmt"
+	"io"
@@ -4,0 +8,2 @@ import (
+	"strconv"
+	"strings"
@@ -50,0 +56,214 @@ func (h *Handler) APIGetProjects(c echo.Context) error {
+// ProjectSettingsAgentOption is the safe agent selector projection exposed to clients.
+type ProjectSettingsAgentOption struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+}
+
+// ProjectSettingsResponse is the editable project settings resource plus server-owned metadata.
+type ProjectSettingsResponse struct {
+	ID                          string                       `json:"id"`
+	Name                        string                       `json:"name"`
+	Description                 string                       `json:"description"`
+	RepositorySource            string                       `json:"repository_source"`
+	RepositoryPath              string                       `json:"repository_path"`
+	GitHubURL                   string                       `json:"github_url"`
+	DefaultAgentID              string                       `json:"default_agent_id"`
+	DefaultAgentName            string                       `json:"default_agent_name,omitempty"`
+	MaxWorkers                  *int                         `json:"max_workers" extensions:"x-nullable"`
+	LocalRepositoryPathsEnabled bool                         `json:"local_repository_paths_enabled"`
+	AvailableAgents             []ProjectSettingsAgentOption `json:"available_agents"`
+}
+
+// ProjectSettingsUpdateRequest is the complete editable settings payload.
+// Read-only metadata is intentionally excluded from updates.
+type ProjectSettingsUpdateRequest struct {
+	Name             *string         `json:"name"`
+	Description      *string         `json:"description"`
+	RepositorySource *string         `json:"repository_source"`
+	RepositoryPath   *string         `json:"repository_path"`
+	GitHubURL        *string         `json:"github_url"`
+	DefaultAgentID   *string         `json:"default_agent_id"`
+	MaxWorkers       json.RawMessage `json:"max_workers"`
+}
+
+// ProjectSettingsUpdateSchema documents the complete editable settings payload.
+type ProjectSettingsUpdateSchema struct {
+	Name             string `json:"name" binding:"required"`
+	Description      string `json:"description" binding:"required"`
+	RepositorySource string `json:"repository_source" binding:"required"`
+	RepositoryPath   string `json:"repository_path" binding:"required"`
+	GitHubURL        string `json:"github_url" binding:"required"`
+	DefaultAgentID   string `json:"default_agent_id" binding:"required"`
+	MaxWorkers       *int   `json:"max_workers" binding:"required" extensions:"x-nullable"`
+}
+
+// APIGetProjectSettings godoc
+// @Summary Get project settings
+// @Description Get the authoritative editable settings and server-owned edit metadata for one project.
+// @Tags projects
+// @Produce json
+// @Param id path string true "Project ID"
+// @Success 200 {object} ProjectSettingsResponse
+// @Failure 404 {object} ErrorResponse
+// @Failure 500 {object} ErrorResponse
+// @Router /api/projects/{id}/settings [get]
+func (h *Handler) APIGetProjectSettings(c echo.Context) error {
+	projectID := c.Param("id")
+	project, err := h.projectSvc.GetByID(c.Request().Context(), projectID)
+	if err != nil {
+		applog.Infof("[handler] APIGetProjectSettings fetch error id=%s: %v", projectID, err)
+		return c.JSON(http.StatusInternalServerError, ErrorResponse{Error: "failed to fetch project settings"})
+	}
+	if project == nil {
+		return c.JSON(http.StatusNotFound, ErrorResponse{Error: "project not found"})
+	}
+	if h.llmConfigRepo == nil {
+		return c.JSON(http.StatusInternalServerError, ErrorResponse{Error: "failed to fetch available agents"})
+	}
+	agents, err := h.llmConfigRepo.ListChatSelectionOptions(c.Request().Context())
+	if err != nil {
+		applog.Infof("[handler] APIGetProjectSettings agent options error id=%s: %v", projectID, err)
+		return c.JSON(http.StatusInternalServerError, ErrorResponse{Error: "failed to fetch available agents"})
+	}
+
+	source := "local"
+	if strings.TrimSpace(project.RepoURL) != "" {
+		source = "github"
+	}
+	response := ProjectSettingsResponse{
+		ID:                          project.ID,
+		Name:                        project.Name,
+		Description:                 project.Description,
+		RepositorySource:            source,
+		RepositoryPath:              project.RepoPath,
+		GitHubURL:                   project.RepoURL,
+		MaxWorkers:                  project.MaxWorkers,
+		LocalRepositoryPathsEnabled: h.isLocalRepoPathEnabled(),
+		AvailableAgents:             make([]ProjectSettingsAgentOption, 0, len(agents)),
+	}
+	if project.DefaultAgentConfigID != nil {
+		response.DefaultAgentID = *project.DefaultAgentConfigID
+	}
+	for _, agent := range agents {
+		response.AvailableAgents = append(response.AvailableAgents, ProjectSettingsAgentOption{ID: agent.ID, Name: agent.Name})
+		if agent.ID == response.DefaultAgentID {
+			response.DefaultAgentName = agent.Name
+		}
+	}
+	return c.JSON(http.StatusOK, response)
+}
+
+// APIUpdateProjectSettings godoc
+// @Summary Update project settings
+// @Description Validate and persist the complete project settings resource using the same safeguards as the browser settings form.
+// @Tags projects
+// @Accept json
+// @Produce json
+// @Param id path string true "Project ID"
+// @Param settings body ProjectSettingsUpdateSchema true "Editable project settings"
+// @Success 204 "Project settings updated"
+// @Failure 400 {object} ErrorResponse
+// @Failure 404 {object} ErrorResponse
+// @Failure 500 {object} ErrorResponse
+// @Router /api/projects/{id}/settings [put]
+func (h *Handler) APIUpdateProjectSettings(c echo.Context) error {
+	projectID := c.Param("id")
+	project, err := h.projectSvc.GetByID(c.Request().Context(), projectID)
+	if err != nil {
+		applog.Infof("[handler] APIUpdateProjectSettings fetch error id=%s: %v", projectID, err)
+		return c.JSON(http.StatusInternalServerError, ErrorResponse{Error: "failed to fetch project settings"})
+	}
+	if project == nil {
+		return c.JSON(http.StatusNotFound, ErrorResponse{Error: "project not found"})
+	}
+	globalMaxWorkers, err := h.configuredGlobalWorkerLimit(c.Request().Context())
+	if err != nil {
+		return c.JSON(http.StatusInternalServerError, ErrorResponse{Error: "failed to read global worker limit"})
+	}
+	settings, err := decodeProjectSettingsUpdate(c, projectSettingsUpdateOptions{
+		LocalRepoPathEnabled: h.isLocalRepoPathEnabled(),
+		GitHubSvc:            h.githubSvc,
+		CurrentProject:       project,
+		GlobalMaxWorkers:     globalMaxWorkers,
+	})
+	if err != nil {
+		return c.JSON(http.StatusBadRequest, ErrorResponse{Error: err.Error()})
+	}
+	cloneFailure, err := h.persistProjectSettings(c.Request().Context(), project, settings)
+	if err != nil {
+		message := err.Error()
+		if cloneFailure {
+			message = fmt.Sprintf("failed to clone GitHub repository: %v", err)
+		}
+		applog.Infof("[handler] APIUpdateProjectSettings persist error id=%s: %v", projectID, err)
+		return c.JSON(http.StatusBadRequest, ErrorResponse{Error: message})
+	}
+	if h.workerSvc != nil {
+		h.workerSvc.ReconcilePendingTasks(c.Request().Context())
+		h.workerSvc.DispatchNext()
+	}
+	return c.NoContent(http.StatusNoContent)
+}
+
+const maxProjectSettingsRequestBytes = 1 << 20
+
+type projectSettingsUpdateOptions = projectFormSettingsOptions
+
+func decodeProjectSettingsUpdate(c echo.Context, opts projectSettingsUpdateOptions) (projectFormSettings, error) {
+	request := c.Request()
+	request.Body = http.MaxBytesReader(c.Response(), request.Body, maxProjectSettingsRequestBytes)
+	decoder := json.NewDecoder(request.Body)
+	decoder.DisallowUnknownFields()
+	var payload ProjectSettingsUpdateRequest
+	if err := decoder.Decode(&payload); err != nil {
+		return projectFormSettings{}, fmt.Errorf("invalid project settings JSON: %w", err)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			err = fmt.Errorf("multiple JSON values")
+		}
+		return projectFormSettings{}, fmt.Errorf("invalid project settings JSON: %w", err)
+	}
+	for _, field := range []struct {
+		name  string
+		value *string
+	}{
+		{"name", payload.Name}, {"description", payload.Description},
+		{"repository_source", payload.RepositorySource}, {"repository_path", payload.RepositoryPath},
+		{"github_url", payload.GitHubURL}, {"default_agent_id", payload.DefaultAgentID},
+	} {
+		if field.value == nil {
+			return projectFormSettings{}, fmt.Errorf("project settings field %s is required", field.name)
+		}
+	}
+	if len(payload.MaxWorkers) == 0 {
+		return projectFormSettings{}, fmt.Errorf("project settings field max_workers is required")
+	}
+	repositorySource := strings.ToLower(strings.TrimSpace(*payload.RepositorySource))
+	if repositorySource != "local" && repositorySource != "github" {
+		return projectFormSettings{}, fmt.Errorf("repository_source must be local or github")
+	}
+	var maxWorkers *int
+	if string(payload.MaxWorkers) != "null" {
+		var value int
+		if err := json.Unmarshal(payload.MaxWorkers, &value); err != nil {
+			return projectFormSettings{}, fmt.Errorf("max_workers must be an integer or null")
+		}
+		maxWorkers = &value
+	}
+	maxWorkersValue := ""
+	if maxWorkers != nil {
+		maxWorkersValue = strconv.Itoa(*maxWorkers)
+	}
+	return parseProjectSettingsValues(projectSettingsValues{
+		Name:                 *payload.Name,
+		Description:          *payload.Description,
+		RepositorySource:     *payload.RepositorySource,
+		RepositoryPath:       *payload.RepositoryPath,
+		GitHubURL:            *payload.GitHubURL,
+		DefaultAgentConfigID: *payload.DefaultAgentID,
+		MaxWorkers:           maxWorkersValue,
+	}, opts)
+}
+
