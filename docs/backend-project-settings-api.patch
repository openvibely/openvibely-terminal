+func TestAPIProjectSettingsRoutesAreRegisteredAndProjectScoped(t *testing.T) {
+	t.Setenv("OPENVIBELY_ENABLE_LOCAL_REPO_PATH", "true")
+	h, e, _ := setupTestHandler(t)
+	ctx := context.Background()
+	first := &models.Project{Name: "First Project", Description: "first", RepoPath: t.TempDir()}
+	second := &models.Project{Name: "Second Project", Description: "second", RepoPath: t.TempDir()}
+	for _, project := range []*models.Project{first, second} {
+		if err := h.projectSvc.Create(ctx, project); err != nil {
+			t.Fatalf("create project %q: %v", project.Name, err)
+		}
+	}
+
+	request := func(method, path string, payload map[string]any) *httptest.ResponseRecorder {
+		t.Helper()
+		body := ""
+		if payload != nil {
+			encoded, err := json.Marshal(payload)
+			if err != nil {
+				t.Fatalf("encode settings: %v", err)
+			}
+			body = string(encoded)
+		}
+		recorder := httptest.NewRecorder()
+		req := httptest.NewRequest(method, path, strings.NewReader(body))
+		if payload != nil {
+			req.Header.Set("Content-Type", "application/json")
+		}
+		e.ServeHTTP(recorder, req)
+		return recorder
+	}
+
+	getFirst := request(http.MethodGet, "/api/projects/"+first.ID+"/settings", nil)
+	if getFirst.Code != http.StatusOK {
+		t.Fatalf("GET project settings route = %d: %s", getFirst.Code, getFirst.Body.String())
+	}
+	var firstSettings ProjectSettingsResponse
+	if err := json.Unmarshal(getFirst.Body.Bytes(), &firstSettings); err != nil {
+		t.Fatalf("decode first project settings: %v", err)
+	}
+	if firstSettings.ID != first.ID || firstSettings.Name != first.Name || firstSettings.Description != first.Description {
+		t.Fatalf("GET returned settings for the wrong project: %+v", firstSettings)
+	}
+
+	update := map[string]any{
+		"name": "Updated First", "description": "changed first", "repository_source": "local",
+		"repository_path": first.RepoPath, "github_url": "", "default_agent_id": "", "max_workers": nil,
+	}
+	putFirst := request(http.MethodPut, "/api/projects/"+first.ID+"/settings", update)
+	if putFirst.Code != http.StatusNoContent {
+		t.Fatalf("PUT project settings route = %d: %s", putFirst.Code, putFirst.Body.String())
+	}
+	persistedFirst, err := h.projectSvc.GetByID(ctx, first.ID)
+	if err != nil {
+		t.Fatalf("read updated first project: %v", err)
+	}
+	persistedSecond, err := h.projectSvc.GetByID(ctx, second.ID)
+	if err != nil {
+		t.Fatalf("read second project: %v", err)
+	}
+	if persistedFirst.Name != "Updated First" || persistedFirst.Description != "changed first" {
+		t.Fatalf("PUT did not update the path project: %+v", persistedFirst)
+	}
+	if persistedSecond.Name != second.Name || persistedSecond.Description != second.Description || persistedSecond.RepoPath != second.RepoPath {
+		t.Fatalf("PUT for %q affected another project: %+v", first.ID, persistedSecond)
+	}
+
+	missingGet := request(http.MethodGet, "/api/projects/missing-project/settings", nil)
+	if missingGet.Code != http.StatusNotFound || !strings.Contains(missingGet.Body.String(), "project not found") {
+		t.Fatalf("GET missing project = %d %s, want clear 404", missingGet.Code, missingGet.Body.String())
+	}
+	missingPut := request(http.MethodPut, "/api/projects/missing-project/settings", update)
+	if missingPut.Code != http.StatusNotFound || !strings.Contains(missingPut.Body.String(), "project not found") {
+		t.Fatalf("PUT missing project = %d %s, want clear 404", missingPut.Code, missingPut.Body.String())
+	}
+	persistedFirst, err = h.projectSvc.GetByID(ctx, first.ID)
+	if err != nil {
+		t.Fatalf("re-read first project: %v", err)
+	}
+	persistedSecond, err = h.projectSvc.GetByID(ctx, second.ID)
+	if err != nil {
+		t.Fatalf("re-read second project: %v", err)
+	}
+	if persistedFirst.Name != "Updated First" || persistedSecond.Name != second.Name {
+		t.Fatalf("missing project update changed stored projects: first=%+v second=%+v", persistedFirst, persistedSecond)
+	}
+}
