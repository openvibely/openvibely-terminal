+func TestAPIProjectSettingsUpdateRejectsInvalidAndUnsafeSettings(t *testing.T) {
+	t.Setenv("OPENVIBELY_ENABLE_LOCAL_REPO_PATH", "false")
+	h, e, _ := setupTestHandler(t)
+	ctx := context.Background()
+	disabled := false
+	h.localRepoPathEnabled = &disabled
+	h.githubSvc = &fakeGitHubService{recloneFn: func(_ context.Context, _, _, repoURL string) (string, string, error) {
+		return "/managed/remote", repoURL, nil
+	}}
+
+	for _, tc := range []struct {
+		name    string
+		mutate  func(map[string]any)
+		wantErr string
+	}{
+		{name: "blank name", mutate: func(payload map[string]any) { payload["name"] = "  " }, wantErr: "Project name is required"},
+		{name: "negative worker limit", mutate: func(payload map[string]any) { payload["max_workers"] = -1 }, wantErr: "0 or a positive whole number"},
+		{name: "local paths disabled", mutate: func(payload map[string]any) {
+			payload["repository_source"] = "local"
+			payload["repository_path"] = "/tmp/not-allowed"
+		}, wantErr: "Local repository paths are disabled"},
+		{name: "invalid repository source", mutate: func(payload map[string]any) { payload["repository_source"] = "browser" }, wantErr: "repository_source must be local or github"},
+		{name: "unknown field", mutate: func(payload map[string]any) { payload["browser_only"] = "ignored" }, wantErr: "unknown field"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			project := &models.Project{Name: "Remote Project " + tc.name, RepoPath: "/managed/remote", RepoURL: "https://github.com/acme/remote"}
+			if err := h.projectSvc.Create(ctx, project); err != nil {
+				t.Fatalf("create project: %v", err)
+			}
+			payload := map[string]any{
+				"name": project.Name, "description": "", "repository_source": "github",
+				"repository_path": project.RepoPath, "github_url": project.RepoURL,
+				"default_agent_id": "", "max_workers": nil,
+			}
+			tc.mutate(payload)
+			body, err := json.Marshal(payload)
+			if err != nil {
+				t.Fatal(err)
+			}
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(http.MethodPut, "/api/projects/"+project.ID+"/settings", strings.NewReader(string(body)))
+			request.Header.Set("Content-Type", "application/json")
+			e.ServeHTTP(recorder, request)
+			if recorder.Code != http.StatusBadRequest || !strings.Contains(recorder.Body.String(), tc.wantErr) {
+				t.Fatalf("PUT settings = %d %s, want 400 with %q", recorder.Code, recorder.Body.String(), tc.wantErr)
+			}
+			persisted, err := h.projectSvc.GetByID(ctx, project.ID)
+			if err != nil {
+				t.Fatalf("load project after rejected update: %v", err)
+			}
+			if persisted.Name != project.Name || persisted.RepoPath != project.RepoPath || persisted.RepoURL != project.RepoURL {
+				t.Fatalf("rejected update mutated project: %+v", persisted)
+			}
+		})
+	}
+}
