+
+	"github.com/openvibely/openvibely/internal/models"
+)
+
+func TestAPIProjectSettingsReadAndUpdateJSONContract(t *testing.T) {
+	t.Setenv("OPENVIBELY_ENABLE_LOCAL_REPO_PATH", "true")
+	h, e, agentRepo := setupTestHandler(t)
+	ctx := context.Background()
+
+	agent := createAgent(t, agentRepo, func(agent *models.LLMConfig) {
+		agent.Name = "Settings Agent"
+	})
+	workers := 3
+	project := &models.Project{
+		Name: "Settings Project", Description: "before", RepoPath: t.TempDir(),
+		DefaultAgentConfigID: &agent.ID, MaxWorkers: &workers,
+	}
+	if err := h.projectSvc.Create(ctx, project); err != nil {
+		t.Fatalf("create project: %v", err)
+	}
+
+	read := func() ProjectSettingsResponse {
+		t.Helper()
+		recorder := httptest.NewRecorder()
+		e.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/api/projects/"+project.ID+"/settings", nil))
+		if recorder.Code != http.StatusOK {
+			t.Fatalf("GET settings = %d: %s", recorder.Code, recorder.Body.String())
+		}
+		var got ProjectSettingsResponse
+		if err := json.Unmarshal(recorder.Body.Bytes(), &got); err != nil {
+			t.Fatalf("decode GET settings: %v", err)
+		}
+		return got
+	}
+
+	before := read()
+	if before.ID != project.ID || before.Name != project.Name || before.Description != "before" || before.RepositorySource != "local" || before.RepositoryPath != project.RepoPath {
+		t.Fatalf("initial settings = %+v", before)
+	}
+	if before.DefaultAgentID != agent.ID || before.DefaultAgentName != agent.Name || before.MaxWorkers == nil || *before.MaxWorkers != workers {
+		t.Fatalf("initial agent/worker settings = %+v", before)
+	}
+	if !before.LocalRepositoryPathsEnabled {
+		t.Fatalf("local repository setting was not returned: %+v", before)
+	}
+	var foundAgent bool
+	for _, option := range before.AvailableAgents {
+		if option == (ProjectSettingsAgentOption{ID: agent.ID, Name: agent.Name}) {
+			foundAgent = true
+		}
+	}
+	if !foundAgent {
+		t.Fatalf("available agents omitted selected agent: %+v", before.AvailableAgents)
+	}
+
+	payload := map[string]any{
+		"name": "Updated Project", "description": "after", "repository_source": "local",
+		"repository_path": "/tmp/updated managed path", "github_url": "",
+		"default_agent_id": "", "max_workers": 5,
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodPut, "/api/projects/"+project.ID+"/settings", strings.NewReader(string(body)))
+	request.Header.Set("Content-Type", "application/json")
+	e.ServeHTTP(recorder, request)
+	if recorder.Code != http.StatusNoContent {
+		t.Fatalf("PUT settings = %d: %s", recorder.Code, recorder.Body.String())
+	}
+
+	persisted, err := h.projectSvc.GetByID(ctx, project.ID)
+	if err != nil {
+		t.Fatalf("load persisted project: %v", err)
+	}
+	if persisted.Name != payload["name"] || persisted.Description != payload["description"] || persisted.RepoPath != payload["repository_path"] || persisted.RepoURL != "" {
+		t.Fatalf("persisted project = %+v", persisted)
+	}
+	if persisted.DefaultAgentConfigID != nil || persisted.MaxWorkers == nil || *persisted.MaxWorkers != 5 {
+		t.Fatalf("persisted agent/worker settings = %+v", persisted)
+	}
+	after := read()
+	if after.Name != payload["name"] || after.Description != payload["description"] || after.RepositoryPath != payload["repository_path"] || after.DefaultAgentID != "" || after.MaxWorkers == nil || *after.MaxWorkers != 5 {
+		t.Fatalf("authoritative settings after PUT = %+v", after)
+	}
+
+	for _, workerLimit := range []struct {
+		name string
+		max  any
+		want *int
+	}{
+		{name: "explicit zero", max: 0, want: intPointer(0)},
+		{name: "inherit", max: nil},
+	} {
+		t.Run(workerLimit.name, func(t *testing.T) {
+			update := map[string]any{
+				"name": "Updated Project", "description": "after", "repository_source": "local",
+				"repository_path": "/tmp/updated managed path", "github_url": "",
+				"default_agent_id": "", "max_workers": workerLimit.max,
+			}
+			updateBody, err := json.Marshal(update)
+			if err != nil {
+				t.Fatal(err)
+			}
+			updateRecorder := httptest.NewRecorder()
+			updateRequest := httptest.NewRequest(http.MethodPut, "/api/projects/"+project.ID+"/settings", strings.NewReader(string(updateBody)))
+			updateRequest.Header.Set("Content-Type", "application/json")
+			e.ServeHTTP(updateRecorder, updateRequest)
+			if updateRecorder.Code != http.StatusNoContent {
+				t.Fatalf("PUT worker limit = %d: %s", updateRecorder.Code, updateRecorder.Body.String())
+			}
+			persisted, err := h.projectSvc.GetByID(ctx, project.ID)
+			if err != nil {
+				t.Fatalf("load project after worker-limit update: %v", err)
+			}
+			if workerLimit.want == nil {
+				if persisted.MaxWorkers != nil {
+					t.Fatalf("persisted max_workers = %v, want null", persisted.MaxWorkers)
+				}
+			} else if persisted.MaxWorkers == nil || *persisted.MaxWorkers != *workerLimit.want {
+				t.Fatalf("persisted max_workers = %v, want %d", persisted.MaxWorkers, *workerLimit.want)
+			}
+			refreshed := read()
+			if workerLimit.want == nil {
+				if refreshed.MaxWorkers != nil {
+					t.Fatalf("response max_workers = %v, want null", refreshed.MaxWorkers)
+				}
+			} else if refreshed.MaxWorkers == nil || *refreshed.MaxWorkers != *workerLimit.want {
+				t.Fatalf("response max_workers = %v, want %d", refreshed.MaxWorkers, *workerLimit.want)
+			}
+		})
+	}
+}
